{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "NodeNext",
    "target": "ES2018",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "nodenext",
    "importHelpers": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2018", "ES2019", "ES2020"]
  },
  "include": ["main.ts"]
}
